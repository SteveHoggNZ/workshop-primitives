diff --git a/tests/Tasks.App.Tests/ArchiveTests.cs b/tests/Tasks.App.Tests/ArchiveTests.cs
new file mode 100644
index 0000000..86a0ff9
--- /dev/null
+++ b/tests/Tasks.App.Tests/ArchiveTests.cs
@@ -0,0 +1,20 @@
+namespace Tasks.App.Tests;
+
+public class ArchiveTests
+{
+    [Fact]
+    public async Task Archive_lists_completed_tasks_oldest_first()
+    {
+        using var app = new TestApp();
+        var older = app.Tasks.Add("Older");
+        var newer = app.Tasks.Add("Newer");
+        app.Tasks.Complete(older.Id);
+        app.Clock.Advance(TimeSpan.FromMinutes(1));
+        app.Tasks.Complete(newer.Id);
+        using var client = app.CreateClient();
+
+        var html = await client.GetStringAsync("/Archive");
+
+        Assert.True(html.IndexOf("Older", StringComparison.Ordinal) < html.IndexOf("Newer", StringComparison.Ordinal));
+    }
+}
