+++ b/src/Tasks.App/Pages/Archive.cshtml
@@ -0,0 +1,19 @@
+@page
+@model ArchiveModel
+@{
+    ViewData["Title"] = "Archive";
+}
+<h1>Archive</h1>
+@if (Model.Done.Count == 0)
+{
+    <p>No completed tasks yet.</p>
+}
+else
+{
+    <ol>
+        @foreach (var task in Model.Done)
+        {
+            <li>@task.Title</li>
+        }
+    </ol>
+}
