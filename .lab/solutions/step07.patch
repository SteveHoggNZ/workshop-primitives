+namespace Tasks.App.Pages;
+
+public class ArchiveModel(TaskService tasks) : PageModel
+{
+    public IReadOnlyList<TaskItem> Done { get; private set; } = [];
+
+    public void OnGet() => Done = [.. tasks.Completed().OrderBy(t => t.CompletedAt)];
+}
