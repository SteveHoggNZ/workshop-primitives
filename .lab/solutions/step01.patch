diff --git a/src/Tasks.App/Pages/Completed.cshtml b/src/Tasks.App/Pages/Completed.cshtml
new file mode 100644
index 0000000..8fbbf6e
--- /dev/null
+++ b/src/Tasks.App/Pages/Completed.cshtml
@@ -0,0 +1,22 @@
+@page
+@model CompletedModel
+@{
+    ViewData["Title"] = "Completed";
+}
+<section data-page="completed">
+    <h1>Completed</h1>
+    @if (Model.Tasks.Count == 0)
+    {
+        <partial name="_Empty" />
+    }
+    else
+    {
+        <ul>
+            @foreach (var task in Model.Tasks)
+            {
+                <li data-testid="task-row" data-task-id="@task.Id">@task.Title</li>
+            }
+        </ul>
+    }
+    <p>Page loaded at @Model.LoadedAt</p>
+</section>
diff --git a/src/Tasks.App/Pages/Completed.cshtml.cs b/src/Tasks.App/Pages/Completed.cshtml.cs
new file mode 100644
