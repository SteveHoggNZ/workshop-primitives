 namespace Tasks.App.Tests;
 
 public class PageTests
@@ -54,4 +56,32 @@ public class PageTests
 
         Assert.Contains("Completed: Write report", html, StringComparison.Ordinal);
     }
+
+    [Fact]
+    public async Task Completed_lists_done_tasks_with_the_load_time()
+    {
+        using var app = new TestApp();
+        var task = app.Tasks.Add("Write report");
+        app.Tasks.Add("Still open");
+        app.Tasks.Complete(task.Id);
+        using var client = app.CreateClient();
+
+        // Razor encodes "+" as "&#x2B;", so decode before looking for the offset.
+        var html = WebUtility.HtmlDecode(await client.GetStringAsync("/Completed"));
+
+        Assert.Contains($"data-task-id=\"{task.Id}\"", html, StringComparison.Ordinal);
+        Assert.DoesNotContain("Still open", html, StringComparison.Ordinal);
+        Assert.Contains("10:00 +13:00", html, StringComparison.Ordinal);
+    }
+
+    [Fact]
+    public async Task Completed_shows_the_empty_state()
+    {
+        using var app = new TestApp();
+        using var client = app.CreateClient();
+
+        var html = await client.GetStringAsync("/Completed");
+
+        Assert.Contains("Nothing here yet.", html, StringComparison.Ordinal);
+    }
 }
