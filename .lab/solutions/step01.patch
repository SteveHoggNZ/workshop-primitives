--- /dev/null
+++ b/src/Tasks.App/Pages/Completed.cshtml.cs
@@ -0,0 +1,20 @@
+using System.Globalization;
+using Microsoft.AspNetCore.Mvc.RazorPages;
+using Tasks.App.Models;
+using Tasks.App.Services;
+
+namespace Tasks.App.Pages;
+
+public class CompletedModel(TaskService tasks, TimeProvider clock, AppSettings settings) : PageModel
+{
+    public IReadOnlyList<TaskItem> Tasks { get; private set; } = [];
+
+    public string LoadedAt { get; private set; } = "";
+
+    public void OnGet()
+    {
+        Tasks = tasks.Completed();
+        LoadedAt = TimeZoneInfo.ConvertTime(clock.GetUtcNow(), settings.Zone)
+            .ToString("HH:mm zzz", CultureInfo.InvariantCulture);
+    }
+}
