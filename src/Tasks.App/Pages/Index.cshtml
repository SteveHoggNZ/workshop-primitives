@page
@model IndexModel
@{
    ViewData["Title"] = "Tasks";
}
<h1>Open tasks</h1>
<p>@Model.Open.Count open, @Model.DoneCount done.</p>
<ul>
    @foreach (var task in Model.Open)
    {
        <li>@task.Title</li>
    }
</ul>
<h2>Latest activity</h2>
<ul>
    @foreach (var line in Model.Activity)
    {
        <li>@line</li>
    }
</ul>
